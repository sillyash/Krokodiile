# Copy to `.env` (git-ignored) and fill in. Real environment variables take precedence.

# --- Django ---
FIIREFLY_DEBUG=true
# Required when FIIREFLY_DEBUG=false.
FIIREFLY_SECRET_KEY=
FIIREFLY_ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to api/db.sqlite3.
# FIIREFLY_DB_PATH=
# collectstatic output, defaults to api/staticfiles.
# FIIREFLY_STATIC_ROOT=

# --- Frontend ---
# Where users land after logging in (keep the trailing slash).
FIIREFLY_FRONTEND_URL=http://localhost:5173/
FIIREFLY_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Defaults to the CORS origins when empty.
FIIREFLY_CSRF_TRUSTED_ORIGINS=

# --- Arise Connect (https://connect.iiens.net/dashboard/clients) ---
FIIREFLY_ARISE_CLIENT_ID=
FIIREFLY_ARISE_CLIENT_SECRET=
FIIREFLY_ARISE_ISSUER=https://oidc.iiens.net
FIIREFLY_ARISE_SCOPES=openid profile user.profile user.id user.preferred_nickname
# Must match a redirect URI registered on the client.
FIIREFLY_ARISE_REDIRECT_URI=http://localhost:8000/auth/callback/
